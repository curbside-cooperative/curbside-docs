{
  "name": "@curbside/quartz-signature-lines",
  "version": "0.1.0",
  "description": "Renders underscore runs in legal documents as sized, unbreakable rule elements instead of literal text.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "quartz",
    "quartz-plugin",
    "remark",
    "mdast"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    },
    "vfile": {
      "optional": true
    }
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "mdast-util-find-and-replace": "^3.0.2"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-to-hast": "^13.2.1",
    "preact": "^10.28.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "signature-lines",
    "displayName": "Signature Lines",
    "category": "transformer",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 35,
    "defaultEnabled": true,
    "defaultOptions": {
      "fieldRuleMinLength": 16,
      "minRunLength": 3,
      "ariaHidden": true,
      "placeholderFont": "Caveat"
    },
    "optionSchema": {
      "fieldRuleMinLength": {
        "type": "number"
      },
      "minRunLength": {
        "type": "number"
      },
      "ariaHidden": {
        "type": "boolean"
      },
      "placeholderFont": {
        "type": "string"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  }
}
